# Copy to .env and fill in. .env is gitignored.
# Without a key the system runs offline (rule parser + template answers).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or Vertex AI with a service account (file stays outside the repo or in .secrets/):
# SKILLGRAPH_VERTEX_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=         # default: the file's project_id
# GOOGLE_CLOUD_LOCATION=global
# SKILLGRAPH_LLM=auto            # auto | gemini | vertex | off
# SKILLGRAPH_LLM_MODEL=gemini-3.8-flash
# SKILLGRAPH_LLM_CACHE=.cache/llm  # or "off"
# SKILLGRAPH_DATA=data/skillsfuture_dataset.json
